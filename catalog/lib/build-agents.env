# catalog/lib/build-agents.env
#
# Maps the finite `build.agent` enum in schemas/cicd.schema.json to real build-agent
# image references - the one place this mapping lives. Tasks resolve it via
# validate-cicd-config.yaml's agent-image result, never hardcoding an image per name.
# Keep keys in sync with the schema's build.agent enum.
#
# Official Docker Hub images, deliberately not the -alpine variants: every catalog step
# script is bash, and Alpine doesn't ship bash by default (busybox sh only) - hit live
# as a step exit code 127 ("command not found") on the first real pipeline run.
nodejs-18=docker.io/library/node:18
nodejs-20=docker.io/library/node:20
nodejs-22=docker.io/library/node:22
openjdk-17=docker.io/library/eclipse-temurin:17-jdk
openjdk-21=docker.io/library/eclipse-temurin:21-jdk
python-3.11=docker.io/library/python:3.11
python-3.12=docker.io/library/python:3.12
python-3.13=docker.io/library/python:3.13
go-1.22=docker.io/library/golang:1.22
go-1.23=docker.io/library/golang:1.23
go-1.24=docker.io/library/golang:1.24
