{
  "title": "CI/CD Variant 1 - Live Mission Control",
  "uid": "platform-cicd-mission-control",
  "description": "Real-time NOC-style view of the whole platform: what's running right now, which apps are active, and controller health. Designed for a wallboard - big numbers, bar-gauge leaderboards, short time windows. All queries are scoped by the $app_namespace variable so this stays readable as the number of onboarded apps grows.",
  "tags": [
    "platform-cicd",
    "cicd-variant"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "app_namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(tekton_pipelines_controller_pipelinerun_duration_seconds_count, exported_namespace)",
        "includeAll": true,
        "multi": true
      },
      {
        "name": "traceId",
        "type": "textbox",
        "label": "Selected flow (click a row in the pipeline visualizer)",
        "description": "Populated automatically when you click a Trace ID link in the table below - loads that flow's real waterfall into the panel underneath it. Can also be pasted directly. Defaults to a real trace so the panel below is never blank on first load.",
        "current": {
          "text": "a2d4ac5979f7d1030b7a27a136668782",
          "value": "a2d4ac5979f7d1030b7a27a136668782"
        },
        "query": "a2d4ac5979f7d1030b7a27a136668782"
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Platform pulse",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "PipelineRuns running now",
      "description": "Cluster-wide gauge from the Tekton controller itself - not scoped by $app_namespace (the controller doesn't emit this broken out per app).",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 10,
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "blue"
              },
              {
                "value": 6,
                "color": "yellow"
              },
              {
                "value": 9,
                "color": "red"
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "tekton_pipelines_controller_running_pipelineruns",
          "legendFormat": "running"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "TaskRuns running now",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 20,
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "blue"
              },
              {
                "value": 12,
                "color": "yellow"
              },
              {
                "value": 18,
                "color": "red"
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "tekton_pipelines_controller_running_taskruns",
          "legendFormat": "running"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Workqueue depth (all reconcilers)",
      "description": "Sum of tekton_pipelines_controller_workqueue_depth across every reconciler queue. Sustained non-zero means the controller is falling behind.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 5,
                "color": "red"
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(tekton_pipelines_controller_workqueue_depth)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Reconcile error rate (5m)",
      "description": "Share of controller reconcile loops (pipelinerun/taskrun/resolutionrequest) that ended success=\"false\" in the last 5 minutes.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 0.05,
                "color": "yellow"
              },
              {
                "value": 0.2,
                "color": "red"
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(tekton_pipelines_controller_reconcile_count{success=\"false\"}[5m])) / sum(increase(tekton_pipelines_controller_reconcile_count[5m]))"
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "Pipeline visualizer",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 20,
      "type": "table",
      "title": "Flow board - every build->test->deploy->release run, real time",
      "description": "One row per flow trace, most recent first. 'Flow status' is a real signal, not a guess: the flow-root span is sent exactly once, from whichever stage's finally block is actually LAST in that specific flow's steps: list (any of build/test/deploy/release, per-flow - see docs/tracing.md's is-flow-terminal design) - so a trace still showing '<root span not yet received>' genuinely means that flow is either still running or stopped short (a stage failed) before reaching its declared last step. Fixed 2026-08-11: this used to assume release was always last, so any flow without a release step (or with steps after release) showed this status forever even after finishing successfully - see docs/tracing.md. Rows can shuffle between refreshes: Tempo's search is a scatter-gather across blocks that stops once it hits the row limit below, and which traces land closest to that limit isn't perfectly stable run to run - a real Tempo characteristic, not a bug in this query. Click a Trace ID link to load that flow's full waterfall in the panel below.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ .service.name = \"platform-cicd\" && name =~ \"^stage:.*\" } | select(status)",
          "limit": 20
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "nested": true
            },
            "indexByName": {
              "traceName": 0,
              "traceService": 1,
              "startTime": 2,
              "traceDuration": 3,
              "traceID": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceName"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "App Namespace / App"
              },
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceService"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Flow status"
              },
              {
                "id": "custom.width",
                "value": 220
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "<root span not yet received>": {
                        "text": "\u25cf running / incomplete",
                        "color": "orange"
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "platform-cicd": {
                        "text": "\u2713 complete",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "startTime"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Started"
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceDuration"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Duration so far"
              },
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 300000
              },
              {
                "id": "thresholds",
                "value": {
                  "steps": [
                    {
                      "value": 0,
                      "color": "blue"
                    },
                    {
                      "value": 120000,
                      "color": "yellow"
                    },
                    {
                      "value": 240000,
                      "color": "red"
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "custom.width",
                "value": 140
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Load waterfall below",
                    "url": "/d/platform-cicd-mission-control/ci-cd-variant-1-live-mission-control?var-traceId=${__value.raw}",
                    "targetBlank": false
                  },
                  {
                    "title": "Open full detail (governance + logs)",
                    "url": "/d/platform-cicd-pipeline-detail/ci-cd-platform-pipeline-run-detail?var-traceId=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 23,
      "type": "barchart",
      "title": "Selected flow - span durations (clean view)",
      "description": "Every span in the selected trace, plain bars, no filter chrome - the same underlying Tempo data as the full waterfall below, just flattened for an at-a-glance read. Sorted by start order. Fixed 2026-08-11: unit was 'ns', displaying stage/task durations (seconds-to-minutes by design, see docs/tracing.md) as sub-millisecond noise - this query path's duration field is milliseconds, matching the Flow board panel's traceDuration field from the same Tempo datasource.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
