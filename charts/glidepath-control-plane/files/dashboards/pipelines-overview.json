{
  "title": "CI/CD Platform - Pipelines Overview",
  "uid": "platform-cicd-pipelines-overview",
  "tags": ["platform-cicd"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "app_namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(tekton_pipelines_controller_pipelinerun_duration_seconds_count, exported_namespace)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Running now",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(tekton_pipelines_controller_running_pipelineruns_count{exported_namespace=~\"$app_namespace\"})", "legendFormat": "running" }
      ]
    },
    {
      "id": 2,
      "title": "Succeeded (24h)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [
        { "expr": "sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{exported_namespace=~\"$app_namespace\",status=\"success\"}[24h]))", "legendFormat": "succeeded" }
      ]
    },
    {
      "id": 3,
      "title": "Failed (24h)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [
        { "expr": "sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{exported_namespace=~\"$app_namespace\",status=\"failed\"}[24h]))", "legendFormat": "failed" }
      ]
    },
    {
      "id": 4,
      "title": "Success rate (24h)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [
        { "value": 0, "color": "red" }, { "value": 0.8, "color": "yellow" }, { "value": 0.95, "color": "green" }
      ] } } },
      "targets": [
        { "expr": "sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{exported_namespace=~\"$app_namespace\",status=\"success\"}[24h])) / sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{exported_namespace=~\"$app_namespace\"}[24h]))" }
      ]
    },
    {
      "id": 5,
      "title": "Stage duration (p50/p95) - from Tempo spanmetrics",
      "type": "timeseries",
      "description": "Derived from the OTel Collector's spanmetrics connector (observability/kind-observe/otel-collector-values-patch.yaml), bucketed by span_name (\"stage:build\"/\"stage:test\"/\"stage:deploy\") rather than the platform.stage dimension, since span_name is set on every stage span unconditionally while platform.stage depends on the emitting Task actually setting it (fixed and verified live, but this stays the safer grouping key regardless). A cross-check against the per-trace durations visible in pipeline-detail.json, not the primary source (see docs/tracing.md). Deliberately NOT wrapped in rate()/increase(): the shared collector's resource_to_telemetry_conversion promotes k8s.pod.name to a metric label, and since a Tekton pod name is unique per PipelineRun, every one of these bucket series is born once at its final value and never changes again - rate()/increase() need a value to change within the window to report anything, so both silently returned 0 for every bucket regardless of window size (verified live: 5m, 30m, and a 24h increase() all produced NaN; the raw summed value did not). Consequence: this panel is NOT scoped by the dashboard's time picker - it aggregates every historical run the collector still holds a series for, not just what's visible elsewhere on this dashboard. Revisit if/when spanmetrics cardinality is reduced enough for rate() to be meaningful again.",
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(traces_span_metrics_duration_milliseconds_bucket{service_name=\"platform-cicd\", span_name=~\"^stage:.*\"}) by (le, span_name))", "legendFormat": "p50 {{span_name}}" },
        { "expr": "histogram_quantile(0.95, sum(traces_span_metrics_duration_milliseconds_bucket{service_name=\"platform-cicd\", span_name=~\"^stage:.*\"}) by (le, span_name))", "legendFormat": "p95 {{span_name}}" }
      ]
    },
    {
      "id": 6,
      "title": "Recent flow runs (click a trace to drill down)",
      "type": "table",
      "description": "One row per build->test->deploy->release flow. Each row is a single Tempo trace spanning every independently-triggered PipelineRun in that flow - see docs/tracing.md. Click a trace ID to open pipeline-detail.json for the per-stage waterfall.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ .service.name = \"platform-cicd\" && name =~ \"^stage:.*\" }"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "traceID" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Pipeline Run Detail",
                    "url": "/d/platform-cicd-pipeline-detail/ci-cd-platform-pipeline-run-detail?var-traceId=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
