{
  "title": "CI/CD Platform - Release Log",
  "uid": "platform-cicd-release-log",
  "tags": ["platform-cicd"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-30d", "to": "now" },
  "description": "One row per confirmed release (approvers, per-gate results, bypass) - see docs/admin/release-log.md. Cluster-mapped releases only (see that doc's 'Known gap' section) - a same-cluster staging deploy will not show up here yet.",
  "templating": {
    "list": [
      {
        "name": "app_name",
        "type": "textbox",
        "label": "App name",
        "description": "Substring match, e.g. checkout-api. Leave blank for all apps.",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "env",
        "type": "textbox",
        "label": "Env",
        "description": "Substring match, e.g. prod. Leave blank for all envs.",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "status",
        "type": "textbox",
        "label": "Status",
        "description": "Substring match against Succeeded/Failed/Error. Leave blank for all.",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Release log",
      "type": "table",
      "description": "Structured metadata (app/env/status/bypass) is filtered directly via the template variables above - the row detail (approvers, per-gate results, PR info) comes from the log body via an Extract fields (JSON) transform, not the raw Loki query response. See docs/admin/release-log.md.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{service_name=\"platform-cicd\"} | platform_release_log_app_name=~\".*$app_name.*\" | platform_release_log_env=~\".*$env.*\" | platform_release_log_status=~\".*$status.*\" | json"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": { "source": "Line", "format": "json", "replace": false, "keepTime": false }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "labelTypes": true,
              "tsNs": true,
              "id": true,
              "TraceID": true,
              "gates": true,
              "app_namespace": true,
              "chain_id": true,
              "flow_start_time": true,
              "pr_created_at": true,
              "finished_at": true,
              "pr_number": true
            },
            "indexByName": {
              "Time": 0,
              "app_name": 1,
              "env": 2,
              "cluster": 3,
              "status": 4,
              "bypass": 5,
              "pr_title": 6,
              "merged_by": 7,
              "approvers": 8,
              "pr_url": 9,
              "git_url": 10,
              "git_revision": 11
            },
            "renameByName": {
              "app_name": "App",
              "env": "Environment",
              "cluster": "Cluster",
              "status": "Status",
              "bypass": "Bypass",
              "pr_title": "PR",
              "merged_by": "Merged By",
              "approvers": "Approvers",
              "pr_url": "PR Link",
              "git_url": "Repo",
              "git_revision": "Commit",
              "gate_sast": "Sast",
              "gate_image_scan": "Image Scan",
              "gate_provenance": "Provenance",
              "gate_sbom": "Sbom",
              "gate_itsm": "Itsm",
              "gate_qa": "Qa",
              "gate_policy_validation": "Policy Validation",
              "gate_image_promotion": "Image Promotion"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "cellOptions": { "type": "auto" }, "width": 120 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "transparent" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "Succeeded": { "color": "transparent", "text": "Succeeded" } } },
                  { "type": "value", "options": { "Failed": { "color": "#B91C1C", "text": "Failed" } } },
                  { "type": "value", "options": { "Error": { "color": "#B91C1C", "text": "Error" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Bypass" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "transparent" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "true": { "color": "#B91C1C", "text": "BYPASSED" } } },
                  { "type": "value", "options": { "false": { "color": "transparent", "text": "" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "PR" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          },
          {
            "matcher": { "id": "byName", "options": "Approvers" },
            "properties": [{ "id": "custom.width", "value": 160 }]
          },
          {
            "matcher": { "id": "byName", "options": "PR Link" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "links", "value": [{ "title": "Open PR", "url": "${__value.raw}", "targetBlank": true }] },
              { "id": "mappings", "value": [{ "type": "regex", "options": { "pattern": "(.*)", "result": { "text": "Open ↗" } } }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "App" },
            "properties": [{ "id": "custom.width", "value": 150 }]
          },
          {
            "matcher": { "id": "byName", "options": "Environment" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byName", "options": "Cluster" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [{ "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^(Sast|Image Scan|Provenance|Sbom|Itsm|Qa|Policy Validation|Image Promotion)$" },
            "properties": [{ "id": "custom.width", "value": 110 }]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Break-glass merges (bypass = true)",
      "type": "table",
      "description": "Same underlying records as the table above, filtered to merges that bypassed a failing required gate - the release-log's own view of detect-bypass-merge.yaml's Slack alert, but durable/queryable instead of scrollback. See docs/admin/release.md's 'Break-glass' section.",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{service_name=\"platform-cicd\"} | platform_release_log_bypass=\"true\" | json"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": { "source": "Line", "format": "json", "replace": false, "keepTime": false }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "labels": true,
              "labelTypes": true,
              "tsNs": true,
              "id": true,
              "TraceID": true,
              "gates": true,
              "app_namespace": true,
              "cluster": true,
              "status": true,
              "bypass": true,
              "chain_id": true,
              "flow_start_time": true,
              "pr_created_at": true,
              "finished_at": true,
              "pr_number": true,
              "git_url": true,
              "git_revision": true,
              "approvers": true
            },
            "indexByName": {
              "Time": 0,
              "app_name": 1,
              "env": 2,
              "merged_by": 3,
              "pr_title": 4,
              "pr_url": 5
            },
            "renameByName": {
              "app_name": "App",
              "env": "Environment",
              "merged_by": "Merged By",
              "pr_title": "PR",
              "pr_url": "PR Link",
              "gate_sast": "Sast",
              "gate_image_scan": "Image Scan",
              "gate_provenance": "Provenance",
              "gate_sbom": "Sbom",
              "gate_itsm": "Itsm",
              "gate_qa": "Qa",
              "gate_policy_validation": "Policy Validation",
              "gate_image_promotion": "Image Promotion"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "cellOptions": { "type": "auto" }, "width": 110 },
          "color": { "mode": "fixed", "fixedColor": "#B91C1C" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "PR" },
            "properties": [{ "id": "custom.width", "value": 280 }]
          },
          {
            "matcher": { "id": "byName", "options": "PR Link" },
            "properties": [
              { "id": "custom.width", "value": 90 },
              { "id": "links", "value": [{ "title": "Open PR", "url": "${__value.raw}", "targetBlank": true }] },
              { "id": "mappings", "value": [{ "type": "regex", "options": { "pattern": "(.*)", "result": { "text": "Open ↗" } } }] }
            ]
          }
        ]
      }
    }
  ]
}
