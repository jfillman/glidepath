{
    "title": "DORA Variant 2 - Executive Summary",
    "uid": "platform-cicd-dora-executive",
    "description": "For a five-second glance, not a drill-down session. Four numbers, one sentence of context each, nothing else - deliberately the sparsest of the five DORA variants.",
    "tags": ["platform-cicd", "dora", "dora-variant"],
    "schemaVersion": 39,
    "editable": true,
    "time": { "from": "now-30d", "to": "now" },
    "refresh": "5m",
    "templating": {
        "list": [
            { "name": "app_namespace", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" },
              "query": "label_values(dora_releases_total, app_namespace)", "includeAll": true, "multi": true },
            { "name": "app", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" },
              "query": "label_values(dora_releases_total{app_namespace=~\"$app_namespace\"}, app)", "includeAll": true, "multi": true }
        ]
    },
    "panels": [
        {
            "id": 1, "type": "text", "title": "",
            "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
            "options": { "mode": "markdown", "content": "# How is engineering performing? (last 30 days)" }
        },
        {
            "id": 2, "type": "stat", "title": "How often do we ship?",
            "gridPos": { "x": 0, "y": 3, "w": 6, "h": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "options": { "textMode": "value", "colorMode": "value", "graphMode": "none" },
            "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "displayName": "deploys / day",
                "thresholds": { "steps": [ { "value": 0, "color": "red" }, { "value": 1, "color": "orange" }, { "value": 7, "color": "green" } ] } } },
            "targets": [ { "expr": "sum(increase(dora_deployments_total{app_namespace=~\"$app_namespace\",app=~\"$app\"}[30d])) / 30" } ]
        },
        {
            "id": 3, "type": "stat", "title": "How fast does a change reach production?",
            "gridPos": { "x": 6, "y": 3, "w": 6, "h": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "options": { "textMode": "value", "colorMode": "value", "graphMode": "none" },
            "fieldConfig": { "defaults": { "unit": "s", "displayName": "median lead time",
                "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 86400, "color": "orange" }, { "value": 604800, "color": "red" } ] } } },
            "targets": [ { "expr": "histogram_quantile(0.5, sum(rate(dora_lead_time_seconds_bucket{app_namespace=~\"$app_namespace\",app=~\"$app\"}[30d])) by (le))" } ]
        },
        {
            "id": 4, "type": "stat", "title": "How often does a release fail?",
            "gridPos": { "x": 12, "y": 3, "w": 6, "h": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "options": { "textMode": "value", "colorMode": "value", "graphMode": "none" },
            "fieldConfig": { "defaults": { "unit": "percentunit", "displayName": "change failure rate",
                "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 0.15, "color": "orange" }, { "value": 0.3, "color": "red" } ] } } },
            "targets": [ { "expr": "sum(increase(dora_releases_total{app_namespace=~\"$app_namespace\",app=~\"$app\",outcome=\"failed\"}[30d])) / sum(increase(dora_releases_total{app_namespace=~\"$app_namespace\",app=~\"$app\"}[30d]))" } ]
        },
        {
            "id": 5, "type": "stat", "title": "How fast do we recover? (experimental)",
            "gridPos": { "x": 18, "y": 3, "w": 6, "h": 8 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "options": { "textMode": "value", "colorMode": "value", "graphMode": "none" },
            "fieldConfig": { "defaults": { "unit": "s", "displayName": "median MTTR ⚠",
                "thresholds": { "steps": [ { "value": 0, "color": "purple" }, { "value": 3600, "color": "semi-dark-purple" } ] } } },
            "targets": [ { "expr": "histogram_quantile(0.5, sum(rate(dora_time_to_restore_seconds_experimental_bucket{app_namespace=~\"$app_namespace\",app=~\"$app\"}[30d])) by (le))" } ]
        },
        {
            "id": 6, "type": "text", "title": "",
            "gridPos": { "x": 0, "y": 11, "w": 24, "h": 2 },
            "options": { "mode": "markdown", "content": "Change Failure Rate measures release-*process* failure only (no production-incident signal exists yet). MTTR is best-effort and cannot see manual rollbacks outside the pipeline. Full methodology: `docs/dora-metrics.md`." }
        }
    ]
}
